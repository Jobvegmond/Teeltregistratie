# Kopieer dit bestand naar .env en vul je eigen Supabase-connectiestring in.
# Het .env-bestand staat in .gitignore en wordt nooit meegecommit.
#
# Dit bestand is alleen voor lokaal draaien. Op de server (Render-service
# VEMteelt, EU-regio) zet je DATABASE_URL en AUTH_COOKIE_KEY als Environment
# Variables in het Render-dashboard.
#
# Je vindt de string in Supabase onder:
#   Project Settings -> Database -> Connection string
#
# Gebruik de "Session pooler"-variant (IPv4, werkt overal). De directe host
# db.[PROJECT-REF].supabase.co is IPv6-only en faalt op netwerken zonder IPv6
# met "could not translate host name ... Name or service not known".
#
# Session pooler (aanbevolen), poort 5432:
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Directe verbinding (alleen met IPv6), poort 5432:
#   postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# Sleutel waarmee het inlog-cookie wordt ondertekend (streamlit-authenticator).
# Genereer er een met:  python -c "import secrets; print(secrets.token_hex(32))"
AUTH_COOKIE_KEY=vervang-door-een-lange-willekeurige-tekenreeks
